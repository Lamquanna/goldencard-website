# ==============================================================================
# GOLDEN ENERGY ERP PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!
# ==============================================================================

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================

# JWT Secret Key - CRITICAL FOR PRODUCTION
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 64 characters recommended for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-minimum-64-characters-here

# NextAuth Secret (for session management)
# Generate using: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here-generate-with-openssl-rand-base64-32

# NextAuth URL (for OAuth callbacks)
NEXTAUTH_URL=http://localhost:3000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# PostgreSQL Connection String (Primary)
# Format: postgresql://username:password@host:port/database?sslmode=require
# Local: postgresql://postgres:password@localhost:5432/goldencard_erp
# Neon: Get from https://neon.tech → Connection String
DATABASE_URL=postgresql://user:password@host:5432/database

# Vercel Postgres (if using Vercel deployment)
POSTGRES_URL=postgresql://username:password@host.postgres.vercel-storage.com:5432/verceldb
POSTGRES_PRISMA_URL=postgresql://username:password@host.postgres.vercel-storage.com:5432/verceldb?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgresql://username:password@host.postgres.vercel-storage.com:5432/verceldb

# Supabase (Alternative to Vercel Postgres)
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# COZE AI CHATBOT
# ==============================================================================

# Coze Bot ID (publicly visible - safe to expose to frontend)
# Golden Energy Bot: https://www.coze.com/space/7594307184414965813/bot/7594311757871972405
NEXT_PUBLIC_COZE_BOT_ID=7594311757871972405

# Coze API Token (keep secret - backend only)
# Get from: https://www.coze.com/open/oauth/pats
COZE_API_TOKEN=your-coze-api-token-here

# ==============================================================================
# API CONFIGURATION
# ==============================================================================

# Base API URL
# Development: http://localhost:3000/api
# Production: https://yourdomain.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# ==============================================================================
# OPTIONAL: EXTERNAL SERVICES
# ==============================================================================

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Mapbox (for map features)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ciIsImEiOiJ0b2tlbiJ9

# Email service (SendGrid or SMTP)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# SMS service (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# CRON & SCHEDULED TASKS
# ==============================================================================
CRON_SECRET=your-random-secret-here-min-32-chars

# ==============================================================================
# DEVELOPMENT
# ==============================================================================
NODE_ENV=development
DEBUG=true
LOG_LEVEL=debug
NEXT_TELEMETRY_DISABLED=1

# ==============================================================================
# PRODUCTION DEPLOYMENT
# ==============================================================================
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# NEXT_PUBLIC_API_BASE_URL=https://yourdomain.com/api

# ==============================================================================
# SETUP INSTRUCTIONS
# ==============================================================================
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in your actual values (don't use the placeholders above)
#
# 3. For Supabase setup:
#    - Create project at https://supabase.com
#    - Copy URL and keys from Settings → API
#    - Run migrations in SQL Editor
#
# 4. For Neon/PostgreSQL setup:
#    - Create database at https://neon.tech or locally
#    - Copy connection string to DATABASE_URL
#    - Run migrations with psql
#
# 5. Never commit .env.local to version control!
#
# For detailed setup instructions, see DATABASE_SETUP.md
