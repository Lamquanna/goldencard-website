{
  "name": "goldencard-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:quick": "playwright test tests/e2e/smoke.spec.ts",
    "test:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:api": "playwright test tests/e2e/api-health.spec.ts",
    "test:homepage": "playwright test tests/e2e/homepage.spec.ts",
    "test:erp": "playwright test tests/e2e/erp-*.spec.ts --project=chromium",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report tests/e2e-report",
    "prepare": "playwright install",
    "db:init": "node --experimental-modules scripts/init-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:ps1": "powershell -ExecutionPolicy Bypass -File scripts/migrate.ps1",
    "db:migrate:full": "node scripts/run-migrations.js",
    "db:fix-leads": "node scripts/fix-leads-schema.js",
    "db:seed": "node scripts/seed-database.js",
    "db:setup": "npm run db:migrate:full && npm run db:seed",
    "generate:avatars": "node scripts/generate-avatars.js",
    "index-urls": "tsx scripts/google-indexing.ts",
    "test:erp:login": "playwright test tests/e2e/erp-login.spec.ts --project=chromium",
    "test:erp:dashboard": "playwright test tests/e2e/erp-dashboard.spec.ts --project=chromium",
    "test:erp:attendance": "playwright test tests/e2e/erp-attendance.spec.ts --project=chromium",
    "test:erp:projects": "playwright test tests/e2e/erp-projects.spec.ts --project=chromium",
    "test:erp:users": "playwright test tests/e2e/erp-users.spec.ts --project=chromium",
    "test:erp:all": "playwright test tests/e2e/erp-comprehensive.spec.ts --project=chromium",
    "health:check": "curl http://localhost:3000/api/health",
    "health:check:prod": "curl https://goldencard-website.vercel.app/api/health"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "6.9.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.81.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/mapbox-gl": "^3.4.1",
    "@vercel/postgres": "^0.10.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^11.3.19",
    "googleapis": "^144.0.0",
    "gsap": "^3.13.0",
    "iconv-lite": "^0.7.0",
    "immer": "^11.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.545.0",
    "mapbox-gl": "^3.16.0",
    "next": "^16.0.10",
    "next-auth": "^5.0.0-beta.29",
    "pg": "^8.16.3",
    "prisma": "6.9.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.3",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "15.5.5",
    "jsdom": "^24.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.6"
  }
}
